generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(EDITOR)
  active       Boolean    @default(true)
  lastLogin    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  topLevels       TopLevel[]
  apiConfig       ApiConfig?
  sentInvites     Invite[]
  heygenAvatars   HeygenTrainedAvatar[]
  promptTemplates PromptTemplate[]
  mediaLibrary    MediaLibraryItem[]
  bannerProjects  BannerProject[]
  colorThemes     ColorTheme[]
  textTemplates   TextTemplate[]
  customFonts     CustomFont[]
}

model PromptTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  content   String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(EDITOR)
  token       String    @unique @default(cuid())
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

model TopLevel {
  id               String            @id @default(cuid())
  name             String
  order            Int               @default(0)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  keywords         Keyword[]
  wordpressConfig  WordpressConfig?
  shopifyConfig    ShopifyConfig?
  campaignDefaults CampaignDefaults?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model CampaignDefaults {
  id                 String     @id @default(cuid())
  imageTaste         ImageTaste @default(INFOGRAPHIC)
  videoBgSource      String     @default("free")
  topLevelId         String     @unique
  topLevel           TopLevel   @relation(fields: [topLevelId], references: [id], onDelete: Cascade)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Keyword {
  id         String            @id @default(cuid())
  keyword    String
  goal       String            @default("")
  audience   String            @default("")
  topLevelId String
  topLevel   TopLevel          @relation(fields: [topLevelId], references: [id], onDelete: Cascade)
  results    GeneratedResult[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model GeneratedResult {
  id             String       @id @default(cuid())
  keywordText    String
  title          String
  status         ResultStatus @default(DRAFT)
  previousStatus ResultStatus?
  keywordId      String
  keyword        Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  // Persona fields
  demographic  String?  @db.Text
  persona1     String?  @db.Text
  persona2     String?  @db.Text
  persona3     String?  @db.Text
  demoSize1    String?  @db.Text
  demoSize2    String?  @db.Text
  demoSize3    String?  @db.Text

  // Structure fields
  structIntro   String? @db.Text
  structNayami  String? @db.Text
  structP1      String? @db.Text
  structP2      String? @db.Text
  structP3      String? @db.Text
  structCommon  String? @db.Text
  structCta     String? @db.Text
  structMatome  String? @db.Text
  structH2      String? @db.Text

  // Fact check fields
  factCheck       Json?
  targetDecision  String? @db.Text

  article   Article?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id         String        @id @default(cuid())
  status     ArticleStatus @default(READY)
  platform     String?
  publishedUrl String? @db.Text
  uploadedAt   DateTime?
  resultId   String        @unique
  result     GeneratedResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  sections   ArticleSection[]
  images     ArticleImage[]
  uploadMeta   UploadMeta?
  videoScript  VideoScript?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ArticleSection {
  id        String  @id @default(cuid())
  index     Int
  type      String
  heading   String
  content   String  @db.Text
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, index])
}

model ArticleImage {
  id           String     @id @default(cuid())
  index        Int
  enabled      Boolean    @default(true)
  taste        ImageTaste @default(PHOTO)
  prompt       String     @db.Text
  imageUrl     String?
  textInside   Boolean    @default(true)
  overlayTitle String?    @db.Text
  articleId    String
  article      Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  history      ImageHistory[]

  @@unique([articleId, index])
}

model ImageHistory {
  id        String       @id @default(cuid())
  imageUrl  String
  prompt    String       @db.Text
  imageId   String
  image     ArticleImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
}

model WordpressConfig {
  id              String   @id @default(cuid())
  wpUrl           String
  wpUserEncrypted String   @db.Text
  wpPassEncrypted String   @db.Text
  topLevelId      String   @unique
  topLevel        TopLevel @relation(fields: [topLevelId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ShopifyConfig {
  id                    String   @id @default(cuid())
  shopDomain            String
  accessTokenEncrypted  String   @db.Text
  blogId                String   @default("")
  topLevelId            String   @unique
  topLevel              TopLevel @relation(fields: [topLevelId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model UploadMeta {
  id            String        @id @default(cuid())
  slug          String
  excerpt       String        @db.Text
  tags          String
  category      String
  formattedHtml String?       @db.LongText
  aiTitle       String?
  publishStatus PublishStatus @default(DRAFT)
  scheduleDate  DateTime?
  articleId     String        @unique
  article       Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model VideoScript {
  id              String               @id @default(cuid())
  title           String
  audioUrl        String?              @db.Text
  audioStatus     String               @default("pending")
  avatarId        String?
  orientation     String               @default("horizontal")
  theme           String               @default("modern-dark")
  pattern         String               @default("formal")
  voice           String               @default("onyx")
  customAudioUrl  String?              @db.Text
  heygenVideoId    String?
  heygenVideoUrl   String?              @db.Text
  previewVideoUrl  String?              @db.Text
  heygenStatus     String               @default("pending")
  remotionJobId   String?
  remotionVideoUrl String?              @db.Text
  remotionStatus  String               @default("pending")
  articleId       String               @unique
  article         Article              @relation(fields: [articleId], references: [id], onDelete: Cascade)
  sections        VideoScriptSection[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model TtsDictionary {
  id      String @id @default(cuid())
  kanji   String @unique
  reading String
  userId  String
  createdAt DateTime @default(now())
}

model VideoScriptSection {
  id               String      @id @default(cuid())
  sectionNumber    Int
  section          String
  heading          String
  points           String      @db.Text
  type             String      @default("general")
  narration        String      @db.Text
  backgroundKeyword String     @default("")
  visualType       String     @default("avatar")
  visualNote       String     @default("")
  imagePrompt      String     @default("")
  imageUrl         String?
  videoScriptId    String
  videoScript      VideoScript @relation(fields: [videoScriptId], references: [id], onDelete: Cascade)

  @@unique([videoScriptId, sectionNumber])
}

model ApiConfig {
  id                    String   @id @default(cuid())
  claudeApiEncrypted    String?  @db.Text
  openaiApiEncrypted    String?  @db.Text
  geminiApiEncrypted    String?  @db.Text
  googleApiEncrypted    String?  @db.Text
  metaApiEncrypted      String?  @db.Text
  kieApiEncrypted       String?  @db.Text
  pieapiEncrypted       String?  @db.Text
  heygenApiEncrypted    String?  @db.Text
  pexelsApiEncrypted    String?  @db.Text
  unsplashApiEncrypted  String?  @db.Text
  runwayApiEncrypted    String?  @db.Text
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Media library — user-uploaded or AI-generated images/videos that can be
// reused across the app (avatars, vlog images, banner backgrounds).
model MediaLibraryItem {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder       String           @default("")            // virtual folder name; empty = root
  kind         MediaKind        @default(IMAGE)
  filename     String                                    // on-disk filename (uploads/media/<id>.<ext>)
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  durationSec  Int?
  source       String           @default("upload")       // "upload" | "ai" | "pexels" | "unsplash"
  sourceUrl    String?          @db.Text                 // remote URL when re-saved to library
  createdAt    DateTime         @default(now())

  @@index([userId, folder])
}

enum MediaKind {
  IMAGE
  VIDEO
}

// Saved banner editor project — full snapshot of inputs, size, fonts, theme.
model BannerProject {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  sizeId    String                                      // "instagram-square" etc.
  /// JSON snapshot: { inputs, fontSelections, themeId, ribbons[], customLayers[], logo, backgroundUrl, ... }
  data      Json
  thumbUrl  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// User-defined color theme (palette of strings).
model ColorTheme {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  /// JSON: { backgroundColor, titleColor, subtitleColor, badgeBg, badgeText, bodyColor, ... }
  colors    Json
  isPreset  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// User-defined text style template (font + size + weight bundle for a layer).
model TextTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  /// JSON: { title, subtitle, badge, body } each with { fontFamily, fontSize, fontWeight }
  styles    Json
  isPreset  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Custom font face uploaded by the user (woff2/ttf/otf).
model CustomFont {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family     String                                    // CSS font-family name
  filename   String                                    // on-disk filename (uploads/fonts/<id>.<ext>)
  mimeType   String
  weight     Int      @default(400)
  style      String   @default("normal")
  createdAt  DateTime @default(now())

  @@index([userId])
}

model HeygenTrainedAvatar {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarType String              @default("photo")
  name       String
  imageUrl   String              @db.Text
  fileName   String?
  imageKey   String?             @db.Text
  groupId    String?
  avatarId   String?
  status     HeygenAvatarStatus  @default(PENDING)
  errorMsg   String?             @db.Text
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([userId])
}

enum HeygenAvatarStatus {
  PENDING
  UPLOADING
  TRAINING
  READY
  FAILED
}

enum Role {
  SUPERADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum ResultStatus {
  DRAFT
  READY
  KW_DONE
  PERSONA_WIP
  PERSONA_DONE
  STRUCT_WIP
  STRUCT_DONE
  PUBLISHED
  SKIPPED
}

enum ArticleStatus {
  READY
  WRITING
  ARTICLE_DONE
  IMAGING
  IMAGE_DONE
  FORMATTING
  FORMAT_DONE
  UPLOADED
}

enum ImageTaste {
  PHOTO
  TEXT_OVERLAY
  INFOGRAPHIC
  ILLUSTRATION
  CINEMATIC
}

enum PublishStatus {
  PUBLISH
  DRAFT
  SCHEDULE
}
